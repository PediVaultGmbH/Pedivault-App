# ─── PediVault Frontend Environment Variables ────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Backend API ───────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000/api

# ── Anthropic (AI Assistant) ──────────────────────────────────────────────────
REACT_APP_ANTHROPIC_API_KEY=your_anthropic_key_here

# ── OTP / SMS (e.g. Twilio) ───────────────────────────────────────────────────
# These live on the backend — do NOT put them here.
# TWILIO_ACCOUNT_SID=...  ← backend only
# TWILIO_AUTH_TOKEN=...   ← backend only

# ── App Config ────────────────────────────────────────────────────────────────
REACT_APP_APP_NAME=PediVault
REACT_APP_APP_VERSION=1.0.0
REACT_APP_ENV=development
